---
import { Icon } from "astro-icon/components";

const email = "max@cojomax.com";
---

<section id="home" class="mx-auto max-w-4xl px-6 py-16">
  <h1 class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-white">
    Hi, I'm <span class="text-primary-600 dark:text-primary-400">Max</span>
  </h1>
  <p class="mt-2 text-xl font-medium text-neutral-600 dark:text-neutral-400">Lead/Senior Engineer</p>
  <p class="mt-4 max-w-2xl text-lg text-neutral-600 dark:text-neutral-400">
    I build complex web applications using Angular and .NET. Ten years in banking and fintech have taught me to sweat
    the details: performance, UX, error handling, and code the next developer can read.
  </p>
  <p class="mt-4 flex max-w-2xl flex-wrap items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400">
    <span class="inline-flex items-center gap-1.5">
      <svg
        class="inline-block h-[1em] w-[2em] rounded-sm"
        viewBox="0 0 24 12"
        role="img"
        aria-label="Flag of Canada"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect width="24" height="12" fill="#fff" />
        <rect width="6" height="12" fill="#D52B1E" />
        <rect x="18" width="6" height="12" fill="#D52B1E" />
        <path
          d="M12 1.6l1.1 2.4 2.6-.5-1.3 2.3 2.1 1.4-2.5.6.4 2.6-2.4-1.3-2.4 1.3.4-2.6-2.5-.6 2.1-1.4-1.3-2.3 2.6.5z"
          fill="#D52B1E"
        />
      </svg>
      Canadian citizen
    </span>
    <span aria-hidden="true">•</span>
    <span>Based in Johannesburg</span>
    <span aria-hidden="true">•</span>
    <span>Willing to relocate</span>
  </p>

  <div class="mt-6 flex flex-wrap items-center gap-4">
    <a
      href="/Max_Cobbett.pdf"
      download
      class="rounded-xl bg-primary-600 px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-500"
    >
      Download CV
    </a>

    <a
      href={`mailto:${email}`}
      class="rounded-xl border border-neutral-200 px-5 py-2 text-sm font-medium text-neutral-600 transition-colors hover:border-primary-400 hover:text-primary-600 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-primary-500 dark:hover:text-primary-400"
    >
      Email Me
    </a>

    <a
      href="https://github.com/cojomax"
      target="_blank"
      rel="noreferrer"
      aria-label="GitHub"
      class="flex h-10 w-10 items-center justify-center rounded-xl border border-neutral-200 text-neutral-600 transition-colors hover:border-primary-400 hover:text-primary-600 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-primary-500 dark:hover:text-primary-400"
    >
      <Icon name="mdi:github" class="h-5 w-5" />
    </a>

    <a
      href="https://www.linkedin.com/in/max-cobbett/"
      target="_blank"
      rel="noreferrer"
      aria-label="LinkedIn"
      class="flex h-10 w-10 items-center justify-center rounded-xl border border-neutral-200 text-neutral-600 transition-colors hover:border-primary-400 hover:text-primary-600 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-primary-500 dark:hover:text-primary-400"
    >
      <Icon name="mdi:linkedin" class="h-5 w-5" />
    </a>
  </div>
</section>
