---
const skillGroups = [
  {
    label: "Languages",
    skills: ["C#", "TypeScript", "JavaScript", "SQL", "Python"],
  },
  {
    label: "Frameworks & Libraries",
    skills: [
      "Angular",
      ".NET Core",
      ".NET Framework",
      "Astro",
      "Node.js",
      "Tailwind CSS",
      "AG Grid",
      "BPMN.io",
    ],
  },
  {
    label: "Tools & Platforms",
    skills: [
      "Git",
      "Docker",
      "SQL Server",
      "Microsoft Azure DevOps",
      "Firebase",
      "Jenkins",
      "Cloudflare",
    ],
  },
];
---

<section id="skills" class="mx-auto max-w-4xl px-6 py-16">
  <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">
    Skills
  </h2>

  <div class="mt-8 space-y-6">
    {skillGroups.map((group) => (
      <div>
        <h3 class="text-sm font-semibold text-neutral-500 dark:text-neutral-400">
          {group.label}
        </h3>
        <div class="mt-3 flex flex-wrap gap-2">
          {group.skills.map((skill) => (
            <span class="rounded-full bg-primary-50 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-950 dark:text-primary-300">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
