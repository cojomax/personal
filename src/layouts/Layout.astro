---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Max Cobbett",
  description = "Software engineer — work experience, skills, and personal projects.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // Runs before paint to avoid a flash of the wrong theme. Respects a
      // saved preference (set by the toggle in Navbar.astro); otherwise
      // falls back to the visitor's system preference.
      (function () {
        const stored = localStorage.getItem("theme");
        const isDark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
  </head>
  <body class="bg-stone-50 text-neutral-900 antialiased dark:bg-stone-900 dark:text-neutral-100">
    <slot />
  </body>
</html>
