---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Max Cobbett",
  description = "Software engineer — work experience, skills, and personal projects.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-white text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100">
    <slot />
  </body>
</html>
